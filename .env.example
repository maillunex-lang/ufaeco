# Конфигурация сервера БАШЭКО Online. Скопируйте в server/.env (файл .env в git не попадает).
# Значения ниже безопасны ТОЛЬКО для локальной разработки.

ENVIRONMENT=development
HOST=127.0.0.1
PORT=8080
SERVER_URL=http://127.0.0.1:8080
WEBSOCKET_URL=ws://127.0.0.1:8080/ws
DATABASE_URL=postgres://basheco:basheco_dev_only@127.0.0.1:5432/basheco_dev
PROTOCOL_VERSION=1
TICK_RATE=10
SNAPSHOT_RATE=2
RECONNECT_TIMEOUT=60
MAX_MESSAGE_SIZE=16384
HEARTBEAT_INTERVAL_MS=5000
# Игровое время (docs/TIME_MODEL.md): месяц = 24 ч с 09:00 по Уфе, неделя = 6 ч
WORLD_ID=main
WORLD_SEED=20241114
# WORLD_EPOCH=2026-01-01T04:00:00.000Z   # начало месяца №0 (09:00 по Уфе); по умолчанию — ближайшее 09:00 по Уфе
GAME_START_YEAR=2026
GAME_START_MONTH=1
TIME_SPEED=1          # только для разработки: 3600 → игровая неделя = 6 секунд. В production только 1
TICKS_ENABLED=true
RATE_LIMIT_BURST=30
RATE_LIMIT_PER_SECOND=10
